# Copy to .env next to package.json. Real environment variables take priority.

# Used when a run_board call does not choose models. Give one provider:model for
# all three roles, or three separated by commas for one model per role.
BEITDIN_MODELS=anthropic:claude-opus-5-5

# Set a key for each provider you want to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Optional settings, shown with their defaults.
# BEITDIN_MAX_TOKENS=64000
# BEITDIN_TIMEOUT_MS=600000
# BEITDIN_MAX_CONCURRENT_RUNS=4

# Optional folder of your own board JSON files.
# BEITDIN_BOARDS_DIR=/path/to/my/boards

# Optional folder where every completed run is saved as a Markdown file.
# BEITDIN_RUNS_DIR=/path/to/my/runs

# Optional base URL override, available for every provider. Example: Ollama.
# BEITDIN_LOCAL_BASE_URL=http://localhost:11434/v1
